# =============================================================
# public-transport-analytics — .env.example
# Kopeeri: cp .env.example .env
# Genereeri SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================

# ── Andmebaas (pgduckdb) ──────────────────────────────────────
POSTGRES_USER=transport_user_technical
POSTGRES_PASSWORD=muuda_mind
POSTGRES_DB=transport_db
DB_PORT=5432

# Transport DB ühendus (superset_config.py ja setup_superset.py jaoks)
DB_HOST=db
DB_PORT_HOST=55432
DB_NAME=transport_db
DB_USER=transport_user_technical
DB_PASSWORD=muuda_mind

# ── Superset metaandmete baas ─────────────────────────────────
SUPERSET_DB_USER=superset_technical
SUPERSET_DB_PASSWORD=muuda_mind
SUPERSET_DB_NAME=superset_meta

# ── Superset rakenduse seaded ─────────────────────────────────
# Genereeri: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=genereeri_uus_võti
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=muuda_mind
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_DATABASE_URI=postgresql+psycopg2://superset_technical:muuda_mind@superset-db:5432/superset_meta
SUPERSET_URL=http://superset:8088
DASHBOARD_PORT_HOST=8088

# ── Superset kasutajate mandaadid ─────────────────────────────
# Luuakse automaatselt setup_superset.py poolt
PUBLIC_USER_NAME=public_user
PUBLIC_USER_PASSWORD=muuda_mind
TLT_ANALYST_NAME=tlt_analyst
TLT_ANALYST_PASSWORD=muuda_mind
ELRON_ANALYST_NAME=elron_analyst
ELRON_ANALYST_PASSWORD=muuda_mind
DATA_ENGINEER_NAME=data_engineer
DATA_ENGINEER_PASSWORD=muuda_mind

# ── Andmeallikad — GPS ────────────────────────────────────────
# TLT reaalajas GPS feed (uueneb iga 60s)
GPS_URL=https://transport.tallinn.ee/gps.txt
GPS_INTERVAL_SEC=60

# ── Andmeallikad — Kütus ──────────────────────────────────────
# Kütusehindade allikas: 95, 98, Diesel
FUEL_URL=https://www.teadmiseks.ee/kasulikku/kutusehinnad/
FUEL_CRON_HOUR=8
# Elektri börsihind (Nord Pool, Elering API)
ELECTRIC_URL=https://dashboard.elering.ee/api/nps/price
# CNG hind (Alexela uudised — uueneb ~4x aastas)
ALEXELA_URL=https://www.alexela.ee/et/uudised-vana?year=2026&category=78

# ── Andmeallikad — GTFS staatiline sõiduplaan ─────────────────
# TLT (tramm + buss, 81 marsruuti) — uueneb mai/august/detsember
# Mobility Database: https://mobilitydatabase.org/feeds/gtfs/mdb-3047
GTFS_TLT_URL=https://eu-gtfs.remix.com/tallinn.zip
GTFS_TLT_CRON_DAY=sun
GTFS_TLT_CRON_HOUR=3

# Elron (rongid, 28 marsruuti) — uueneb paar korda aastas
# Mobility Database: https://mobilitydatabase.org/feeds/gtfs/mdb-3153
GTFS_ELRON_URL=https://eu-gtfs.remix.com/elron.zip
GTFS_ELRON_CRON_DAY=1
GTFS_ELRON_CRON_HOUR=3

# ── Andmeallikad — Elron reaalajas ───────────────────────────
# Elroni rongide GPS + hilinemised
ELRON_RT_URL=https://elron.ee/map_data.json
ELRON_INTERVAL_SEC=30

# ── dbt transformatsioonid ────────────────────────────────────
DBT_INTERVAL_MIN=5

# ── Öörežiim ─────────────────────────────────────────────────
# GPS ja Elron peatuvad vahemikus NIGHT_START_HOUR–NIGHT_END_HOUR (EEST)
NIGHT_START_HOUR=0
NIGHT_END_HOUR=6

# ── Andmehaldus ───────────────────────────────────────────────
# Bronze andmete säilitusperiood päevades (vanemad kustutatakse kell 03:30)
BRONZE_RETENTION_DAYS=7
